# Copy to `.env` in this folder and fill in. Compose reads it for both variable
# substitution and the api container's env_file.

# Public HTTPS URL of the API subdomain (Vapi posts to ${PUBLIC_BASE_URL}/voice/webhook)
PUBLIC_BASE_URL=https://api.carecloud.example.com

# Database password for the app's own Postgres container
POSTGRES_PASSWORD=change-me-strong

# OpenAI key (registered with Vapi as a bring-your-own-key credential)
OPENAI_API_KEY=sk-...

# Vapi
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=change-me-16-plus-chars

# Guards the /admin/* routes; the console sends it as x-admin-key
ADMIN_API_KEY=change-me

# Console login
APP_USERNAME=admin@carecloud.com
APP_PASSWORD=change-me
SESSION_SECRET=change-me-long-random
