# Server
PORT=3000
NODE_ENV=development
# Public base URL of this API as reachable by Vapi (ngrok URL in local dev)
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Database
DATABASE_URL=postgresql://carecloud:carecloud@localhost:5441/carecloud

# OpenAI (used by Vapi via bring-your-own-key)
OPENAI_API_KEY=sk-...

# Vapi
VAPI_API_KEY=
# Shared secret Vapi sends back in the x-vapi-secret header on every webhook
VAPI_WEBHOOK_SECRET=change-me

# Guards /admin routes via the x-admin-key header. Leave blank to keep them open in dev.
ADMIN_API_KEY=
